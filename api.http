@base = http://localhost:3000

### Executar em ordem após preparar o schema. REST Client captura os IDs das respostas.
# @name createPartner
POST {{base}}/partners
Content-Type: application/json

{ "name": "Partner 1" }

###
@partner_id = {{createPartner.response.body.id}}

### Cliente A compra o lugar
# @name createCustomerA
POST {{base}}/customers
Content-Type: application/json

{ "name": "Customer A", "cpf": "592.110.870-74" }

###
@customer_id = {{createCustomerA.response.body.id}}

### Cliente B entra na fila
# @name createCustomerB
POST {{base}}/customers
Content-Type: application/json

{ "name": "Customer B", "cpf": "703.758.870-91" }

###
@waiting_customer_id = {{createCustomerB.response.body.id}}

###
# @name createEvent
POST {{base}}/events
Content-Type: application/json

{
    "name": "Event 1",
    "description": "Description 1",
    "date": "2027-01-01T00:00:00.000Z",
    "partner_id": "{{partner_id}}"
}

###
@event_id = {{createEvent.response.body.id}}

###
POST {{base}}/events/{{event_id}}/sections
Content-Type: application/json

{
    "name": "Section 1",
    "description": "Description 1",
    "total_spots": 1,
    "price": 200
}

###
PUT {{base}}/events/{{event_id}}/publish-all

###
# @name listSections
GET {{base}}/events/{{event_id}}/sections

###
@section_id = {{listSections.response.body.$[0].id}}

###
# @name listSpots
GET {{base}}/events/{{event_id}}/sections/{{section_id}}/spots

###
@spot_id = {{listSpots.response.body.$[0].id}}

### Compra esgota a seção
# @name createOrder
POST {{base}}/events/{{event_id}}/orders
Content-Type: application/json

{
    "customer_id": "{{customer_id}}",
    "section_id": "{{section_id}}",
    "spot_id": "{{spot_id}}",
    "card_token": "tok_visa"
}

###
@order_id = {{createOrder.response.body.id}}

### Entrada do cliente B: PENDING
POST {{base}}/events/{{event_id}}/sections/{{section_id}}/waiting-list
Content-Type: application/json

{ "customer_id": "{{waiting_customer_id}}" }

### Antes do cancelamento: PENDING
GET {{base}}/events/{{event_id}}/sections/{{section_id}}/waiting-list

### Único comando que dispara as duas reações e a integração: CANCELLED
POST {{base}}/events/{{event_id}}/orders/{{order_id}}/cancel

### Lugar disponível: reserved = false
GET {{base}}/events/{{event_id}}/sections/{{section_id}}/spots

### Depois do cancelamento: NOTIFIED. Conferir também o terminal do apps/emails.
GET {{base}}/events/{{event_id}}/sections/{{section_id}}/waiting-list

### Consultas e alterações do roteiro original
GET {{base}}/partners

###
GET {{base}}/customers

###
GET {{base}}/events

###
GET {{base}}/events/{{event_id}}/orders

###
PUT {{base}}/events/{{event_id}}/sections/{{section_id}}
Content-Type: application/json

{ "name": "Section 1 updated", "description": "Description 1 updated" }

###
PUT {{base}}/events/{{event_id}}/sections/{{section_id}}/spots/{{spot_id}}
Content-Type: application/json

{ "location": "Location 1" }
